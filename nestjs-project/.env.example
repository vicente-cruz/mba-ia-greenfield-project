# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# Object storage (S3 compatível, serviço `storage` do Compose)
# S3_ENDPOINT: API e worker, pela rede do Compose. S3_PUBLIC_ENDPOINT: só para assinar URLs entregues ao navegador.
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=streamtube-app
S3_SECRET_ACCESS_KEY=change-me-storage-app-secret
S3_BUCKET=streamtube
S3_FORCE_PATH_STYLE=true

# Storage container (credencial de root usada só pelo storage e pelo storage-init)
MINIO_ROOT_USER=streamtube-admin
MINIO_ROOT_PASSWORD=change-me-storage-root-secret
# Origens do navegador liberadas no CORS do storage, separadas por vírgula: o frontend (primeira)
# e a página de prova da Fase 03 (serviço proof-browser, V-08). Sem espaços.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3001,http://localhost:4173

# Queue (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Processamento de vídeo e workers do BullMQ
# VIDEO_PROCESSING_TIMEOUT_MS: timeout por chamada do ffprobe e do ffmpeg, que mata o processo (prova V-04).
VIDEO_PROCESSING_ATTEMPTS=3
VIDEO_PROCESSING_BACKOFF_MS=5000
VIDEO_PROCESSING_CONCURRENCY=1
VIDEO_PROCESSING_TIMEOUT_MS=60000
# Lock e stall dos workers das duas filas: padrões efetivos do BullMQ 6.7.7 confirmados pela prova V-11.
QUEUE_LOCK_DURATION_MS=30000
QUEUE_STALLED_INTERVAL_MS=30000
QUEUE_MAX_STALLED_COUNT=1

# Upload: 10 GB decimais em partes de 64 MiB (TD-03)
VIDEO_MAX_SIZE_BYTES=10000000000
UPLOAD_PART_SIZE_BYTES=67108864
# Prazo absoluto da sessão, contado da ativação. Somado a UPLOAD_SESSION_CLAIM_TTL_SECONDS, precisa
# ficar abaixo das 48h de MINIO_API_STALE_UPLOADS_EXPIRY do storage (prova V-01).
UPLOAD_SESSION_TTL=24h
UPLOAD_SESSION_CLAIM_TTL_SECONDS=300

# URLs pré-assinadas (máximo de 604800 s)
UPLOAD_PART_URL_TTL_SECONDS=900
PLAYBACK_URL_TTL_SECONDS=3600
DOWNLOAD_URL_TTL_SECONDS=300

# Processamento: ações de fila pendentes, recuperações por geração e alerta de fila parada (TD-12)
PROCESSING_JOB_ACTION_TTL_SECONDS=120
PROCESSING_MAX_RECOVERIES=2
PROCESSING_STUCK_ALERT_MS=600000
PROCESSING_RECONCILE_GRACE_MS=300000

# Manutenção periódica (Job Schedulers no video-worker)
MAINTENANCE_SWEEP_INTERVAL_MS=60000
MAINTENANCE_RECONCILE_INTERVAL_MS=60000
MAINTENANCE_CLEANUP_INTERVAL_MS=3600000
MAINTENANCE_BATCH_SIZE=100
STORAGE_CLEANUP_GRACE_MS=3600000
